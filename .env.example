# Django (a secret key is generated in DATA_DIR when DJANGO_SECRET_KEY is empty)
DJANGO_SECRET_KEY=""
DEBUG=False
# No accounts: everyone is logged in as one local user (used by the Android app)
# SINGLE_USER_MODE=False
# Comma-separated hosts allowed to reach the server (default: localhost,127.0.0.1)
# ALLOWED_HOSTS=localhost,127.0.0.1
# Where the SQLite databases are stored (default: ./data)
# DATA_DIR=

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# Built-in API keys (can be overridden from the Settings page)
# Groq (https://console.groq.com/)
GROQ_API_KEY=
# INSTANT_LLM=llama-3.1-8b-instant
# POWERFUL_LLM=openai/gpt-oss-120b

# Cohere embeddings + reranking (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
# EMBEDDING_MODEL=embed-v4.0
# RERANKER_MODEL_NAME=rerank-v3.5
